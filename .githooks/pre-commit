#!/bin/sh
# GoContact Studio — Pre-Commit Quality Gate Hook

echo "[HOOK: pre-commit] Verifying staged files..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check if running in Community repo or Master repo
ORIGIN_URL=$(git remote get-url origin 2>/dev/null || echo "")

case "$ORIGIN_URL" in
    *"gocontact-community"*)
        LEAK_PATTERNS="docs/roadmap docs/adr 07_FUTURE_ROADMAP 08_STRATEGIC .agents tools AGENTS.md 06_DEFENSE_GUIDE 05_ROADMAP_AND_STAGES .env id_rsa"
        ;;
    *)
        # In Master SSOT, roadmap specs and agents are legitimate; only block credentials
        LEAK_PATTERNS=".env id_rsa id_ed25519 credentials.json"
        ;;
esac

for file in $STAGED_FILES; do
    for pattern in $LEAK_PATTERNS; do
        case "$file" in
            *"$pattern"*)
                echo "❌ [SECURITY ALERT] Attempting to commit confidential secret or forbidden file: $file"
                echo "   Aborting commit."
                exit 1
                ;;
        esac
    done
done

# 2. Go Format Check on staged .go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
if [ -n "$STAGED_GO_FILES" ]; then
    UNFORMATTED=$(gofmt -l $STAGED_GO_FILES)
    if [ -n "$UNFORMATTED" ]; then
        echo "⚠️ [FORMAT WARNING] The following Go files require 'gofmt -w':"
        echo "$UNFORMATTED"
        echo "Run 'gofmt -w <file>' before committing."
        exit 1
    fi
fi

# 3. Clean Architecture: verify zero external imports in internal/domain
DOMAIN_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^internal/domain/.*\.go$' || true)
if [ -n "$DOMAIN_FILES" ]; then
    FORBIDDEN_IMPORTS=$(grep -E '("database/sql"|"fyne.io/|"net/http"|"modernc.org/|internal/)' $DOMAIN_FILES 2>/dev/null || true)
    if [ -n "$FORBIDDEN_IMPORTS" ]; then
        echo "❌ [CLEAN ARCHITECTURE ERROR] Forbidden import detected in internal/domain:"
        echo "$FORBIDDEN_IMPORTS"
        echo "internal/domain must have 0 external or infrastructure dependencies!"
        exit 1
    fi
fi

echo "✅ [HOOK: pre-commit] All checks passed cleanly."
exit 0
