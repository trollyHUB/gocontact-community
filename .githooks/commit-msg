#!/bin/sh
# GoContact Community — Conventional Commits Validator Hook

MSG_FILE="$1"
FIRST_LINE=$(head -n 1 "$MSG_FILE")

# Allow merge commits
if echo "$FIRST_LINE" | grep -qE '^Merge branch'; then
    exit 0
fi

# Allow initial / amend commits
PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_\-\/]+\))?: .+$"

if ! echo "$FIRST_LINE" | grep -qE "$PATTERN"; then
    echo "❌ [COMMIT-MSG ERROR] Commit message does not follow Conventional Commits standard!"
    echo "   Received: \"$FIRST_LINE\""
    echo "   Required format: <type>(<scope>): <subject>"
    echo "   Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    echo "   Example: feat(ui): add keyboard navigation shortcuts"
    exit 1
fi

exit 0
